{
    "name": "speedgoose",
    "version": "2.5.13",
    "description": "Next-level mongoose caching layer with event based cache clearing",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "private": false,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/arqo123/speedgoose.git"
    },
    "author": "Arkadiusz Gil",
    "license": "MIT",
    "keywords": [
        "mongoose",
        "cache",
        "mongodb",
        "redis",
        "ttl"
    ],
    "files": [
        "lib/**/*.js",
        "lib/**/*.d.ts"
    ],
    "lint-staged": {
        "*.{js,ts}": [
            "eslint",
            "prettier --write"
        ]
    },
    "lint-prepush": {
        "base": "master",
        "tasks": {
            "*.{js,ts}": [
                "eslint"
            ]
        }
    },
    "scripts": {
        "test": "NODE_OPTIONS=--experimental-vm-modules jest --forceExit",
        "benchmark": "NODE_OPTIONS=--experimental-vm-modules jest --testPathPattern=benchmark --forceExit --testTimeout=120000",
        "test:debug": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --forceExit",
        "test:redis": "NODE_OPTIONS=--experimental-vm-modules jest -c jest.redis.config.js --runInBand --forceExit",
        "test-watch": "nodemon --exec 'yarn test'",
        "clean": "rimraf ./lib/*",
        "lint:base": "eslint --ext .ts",
        "lint:fix": "eslint . --fix && prettier . --write",
        "lint": "yarn lint:base .",
        "lint:ci": "yarn lint:base --quiet . && tsc -p tsconfig.json",
        "build": "yarn clean && tsc ",
        "prepare": "yarn build",
        "dev": "yarn clean && tsc --watch",
        "semantic-release": "semantic-release",
        "update:check": "ncu",
        "update:apply": "ncu -u && yarn install"
    },
    "dependencies": {
        "debug": "^4.4.3",
        "fastq": "^1.20.3",
        "ioredis": "^6.0.0",
        "keyv": "^4.5.4",
        "mongoose": "^9.11.4",
        "mpath": "^0.9.0",
        "typedi": "^0.10.0"
    },
    "devDependencies": {
        "@commitlint/cli": "21.2.4",
        "@commitlint/config-conventional": "21.2.4",
        "@semantic-release/changelog": "^7.0.0",
        "@semantic-release/git": "^11.0.1",
        "@semantic-release/github": "^12.0.10",
        "@semantic-release/npm": "^13.2.0",
        "@types/debug": "^4.1.13",
        "@types/jest": "30.0.0",
        "@typescript-eslint/eslint-plugin": "8.72.0",
        "@typescript-eslint/parser": "8.72.0",
        "auto-changelog": "^2.7.0",
        "eslint": "10.13.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-prettier": "5.5.7",
        "eslint-plugin-unused-imports": "4.4.1",
        "husky": "9.1.7",
        "ioredis-mock": "^8.13.1",
        "jest": "30.5.2",
        "jest-extended": "7.0.0",
        "lint-prepush": "3.0.3",
        "lint-staged": "17.6.0",
        "mongodb-memory-server": "^11.3.0",
        "npm-check-updates": "^23.1.1",
        "prettier": "3.9.10",
        "rimraf": "^6.1.3",
        "semantic-release": "^25.0.9",
        "ts-jest": "^29.4.15",
        "typescript": "5.9.3"
    },
    "resolutions": {
        "undici": ">=7.24.0",
        "picomatch": ">=4.0.4"
    },
    "bugs": {
        "url": "https://github.com/arqo123/speedgoose/issues"
    },
    "engines": {
        "node": ">=20.19.0"
    },
    "homepage": "https://github.com/arqo123/speedgoose#readme",
    "directories": {
        "lib": "lib"
    }
}
